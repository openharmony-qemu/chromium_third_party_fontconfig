<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="GPL-3.0+" path="m4.*" desc="" />
                <policyitem type="compatibility" name="GPL-2.0+" path="m4.*" desc="" />
                <policyitem type="compatibility" name="Keith Packard" path=".*" desc="" />
